# Prisma Postgres connection string - Hosted on https://console.prisma.io/ under Luciano's personal github account
DATABASE_URL="postgres://USER:PASSWORD@db.prisma.io:5432/postgres?sslmode=require"

# Resend API key (re_...) — from Resend dashboard → API Keys
RESEND_API_KEY=""

# Resend webhook signing secret (format: whsec_...) — get from Resend dashboard → Webhooks
# Webhook URL: https://inbox.riov.com.br/api/webhooks/resend
RESEND_WEBHOOK_SECRET=""

# Secret used to sign session JWTs (HS256). Generate with: openssl rand -base64 32
# Rotating this invalidates every active session.
AUTH_SECRET=""

# Address outgoing mail is sent "From". Must be a verified domain in Resend.
FROM_EMAIL_ADDRESS="inbox@riov.com.br"

# Comma-separated list of employee emails whose inbox messages must remain private to them.
# Other users won't see emails sent to these addresses unless explicitly authorized.
EMPLOYEE_EMAILS="luciano@riov.com.br,example@riov.com.br"

# Cloudflare Turnstile bot/DDoS protection
# Obtain from Cloudflare Dashboard -> Turnstile -> Add Site
# Domain: inbox.riov.com.br (also add localhost for dev testing)
# Public site key (exposed to client to render Turnstile widget):
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
# Private secret key (kept server-side to verify challenge tokens with Cloudflare API):
TURNSTILE_SECRET_KEY=""
