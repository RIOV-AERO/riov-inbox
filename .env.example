# Required — Prisma Postgres connection string
DATABASE_URL="postgres://USER:PASSWORD@db.prisma.io:5432/postgres?sslmode=require"

# Resend API key (re_...) — from Resend dashboard → API Keys
RESEND_API_KEY=""

# Resend webhook signing secret (format: whsec_...) — get from Resend dashboard → Webhooks
# Webhook URL: https://inbox.riov.com.br/api/webhooks/resend
RESEND_WEBHOOK_SECRET=""
