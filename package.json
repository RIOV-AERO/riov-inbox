{
  "name": "riov-inbox",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "webhooks:list": "tsx scripts/webhooks.ts list",
    "webhooks:get": "tsx scripts/webhooks.ts get",
    "webhooks:create": "tsx scripts/webhooks.ts create",
    "webhooks:update": "tsx scripts/webhooks.ts update",
    "webhooks:delete": "tsx scripts/webhooks.ts delete",
    "user:create": "tsx --env-file=.env.local scripts/create-user.ts",
    "db:seed-labels": "tsx --env-file=.env.local scripts/seed-labels.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "latest",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "jose": "^6.2.4",
    "lucide-react": "^1.27.0",
    "next": "^16.2.4",
    "pg": "^8.20.0",
    "pg-cloudflare": "^1.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "svix": "latest",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.19.5",
    "@tailwindcss/postcss": "^4.2.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prisma": "latest",
    "tailwindcss": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.6.0",
    "wrangler": "^4.87.0"
  },
  "packageManager": "pnpm@10.33.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "esbuild",
      "prisma",
      "sharp",
      "workerd"
    ]
  }
}
