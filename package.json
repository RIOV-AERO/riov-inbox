{
  "name": "riov-inbox",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "webhooks:list": "tsx scripts/webhooks.ts list",
    "webhooks:get": "tsx scripts/webhooks.ts get",
    "webhooks:create": "tsx scripts/webhooks.ts create",
    "webhooks:update": "tsx scripts/webhooks.ts update",
    "webhooks:delete": "tsx scripts/webhooks.ts delete"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "latest",
    "dotenv": "^17.4.2",
    "next": "^16.2.4",
    "pg": "^8.20.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "svix": "latest"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prisma": "latest",
    "tailwindcss": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.6.0"
  },
  "packageManager": "pnpm@10.33.2"
}
